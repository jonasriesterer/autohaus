' Preview durch <Alt>d

@startuml ER-Diagramm

' hide the spot
hide circle

' evtl. Prbleme mit Kraehenfuessen vermeiden
skinparam linetype ortho

entity "Autohaus" {
  * id : integer <<generated>>
  * version : integer
  --
  * name : text
  * username : text <<unique>>
  * email : text <<unique>>
  * anzahl_fahrzeuge : integer
  * gruendungsdatum : date
    homepage : text
    telefonnummer : text
    erzeugt : timestamp
    aktualisiert : timestamp
}

entity "Adresse" {
  * id : integer <<generated>>
  --
  * plz : text
  * ort : text
  * land : text
  * autohaus_id : integer <<FK>>
}

entity "Auto" {
  * id : integer <<generated>>
  --
  * kennzeichen : text
  * marke : text
  * modell : text
  * baujahr : decimal
  * autohaus_id : integer <<FK>>
}

Autohaus ||.left.|| Adresse
Autohaus ||..o{ Auto

footer (c) Juergen Zimmermann

@enduml
